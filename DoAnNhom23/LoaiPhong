using System.ComponentModel.Design.Serialization;
using System.Reflection.Metadata;
using Microsoft.Win32.SafeHandles;

namespace ConsoleApp1;

public class Phong
{
    private String roomNumber;
    private RoomStatus _status;
    public int id{get;set;}

    public string RoomNumber
    {
        get
        { 
            return roomNumber
        }
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                throw new ArgumentException("So phong khong duoc de trong.");
            roomNumber = value;
        }
    }
    public int Floor{get;set;}
    public int RoomTypeId{get;set;}
    public int RoomType{get;set;}
    public RoomStatus Status{
        get{
            return _status;}
        private set{
            _status = value;}
    }

    public Room()
    {
        _status = RoomStatus.Available;
    }

    public Room (int id, string roomNumber, int floor,RoomType roomType, int roomTypeId)
    {
        Id = id;
        RoomNumber= roomNumber;
        Floor = floor;
        RoomType = roomType;
        RoomTypeId = roomTypeId;
        _status = RoomStatus.Available;
    }

    public bool IsAvailable(DateTime from, DateTime to,
        IEnumerable<(DateTime CheckIn, DateTime CheckOut)> bookedPeriods)
    {
        if (to.Date <= from.Date)
            return false;
        if (_status == RoomStatus.Maintenance)
            return false;
        foreach (var period in bookedPeriods)
        {
            if(IsOverLap(from, to, period.CheckIn, period.CheckOut))
                return false;
        }

        return true;
    }

    public bool ChangeStatus(RoomStatus newStatus)
    {
        if (!IsStatusChangValid(newStatus))
            return false;
        _status = newStatus;
        return true;
    }

    public decimal CalculatePrice(DateTime checkIn, DateTime checkOut)
    {
        if (RoomType == null)
            throw new InvalidOperationException("Phong chua co kieu phong");
        return RoomType.CalculateTotal(checkIn, checkOut);
    }

    public bool CanAccommodate(int guestCount)
    {
        return RoomType != null && RoomType.CanAccommodate(guestCount);
    }

    public bool IsOverLap(DateTime from1, DateTime to1, DateTime from2, DateTime to2)
    {
        return from1.Date < to2.Date && from2.Date < to2.Date;
    }

    private bool IsStatusChangeValid(RoomStatus newStatus)
    {
        if (newStatus == _status)
            return false;
        switch (_status)
        {
            case RoomStatus.Available :
                return newStatus == RoomStatus.Booked
                       || newStatus == RoomStatus.Occupied
                       || newStatus == RoomStatus.Maintenace;
            case RoomStatus.Booked:
                return newStatus == RoomStatus.Occupied
                       || newStatus == RoomStatus.Available;
            case RoomStatus.Occupied:
                return newStatus == RoomStatus.Cleaning;
            case RoomStatus.Cleaning:
                return newStatus == RoomStatus.Available
                       || newStatus == RoomStatus.Maintenace;
            case newStatus == RoomStatus.Maintenance:
                return newStatus == RoomStatus.Available;
            default:
                return false;
        }
    }

    public override string ToString()
    {
        string type = RoomType != null ? RoomType.Name : "?";
        return $"Phong {roomNumber} ({TypeName}) - {_status}";
    }
}
